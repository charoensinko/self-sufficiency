# ============================================================
# เกษียณสุข — ตัวแปรสภาพแวดล้อม (คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่า)
# ============================================================

# URL โปรเจกต์ Supabase — ดูที่ Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (public) — ดูที่ Dashboard > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — ใช้เฉพาะฝั่ง server (seed/งาน admin) ห้ามใส่ NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# API key ของ OpenRouter (openrouter.ai/keys) — ใช้เฉพาะฝั่ง server เท่านั้น
OPENROUTER_API_KEY=

# URL ของแอป เช่น http://localhost:3000 (dev) หรือ https://xxx.vercel.app (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
